{
  "name": "carfax-abbey-demo",
  "version": "0.1.0",
  "private": true,
  "boxes": 50,
  "ratio": 0.75,
  "deprecated": null,
  "keywords": ["wine", "crypt", true, false, null, 50],
  "env": {
    "es6": true,
    "mocha": false,
    "node": true
  },
  "extends": "eslint:recommended",
  "rules": {
    "indent": ["error", 2],
    "quotes": ["error", "single"],
    "semi": ["error", "always"]
  },
  "hunters": [
    { "name": "Harker", "city": "Whitby", "faith": 12 },
    { "name": "Mina", "city": "London", "faith": null }
  ],
  "escapes": "Line one\nTab\there \"quoted\" \u271D"
}
